# ElectIQ — Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini API Key (from https://aistudio.google.com)
VITE_GEMINI_KEY=your_gemini_api_key_here

# Google Maps Embed API Key (from https://console.cloud.google.com)
VITE_MAPS_KEY=your_maps_api_key_here

# Google Analytics 4 Measurement ID (from https://analytics.google.com)
VITE_GA_ID=your_ga4_measurement_id_here
